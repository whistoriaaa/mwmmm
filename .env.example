# Salin ke .env.local lalu isi nilainya. .env.local tidak di-commit.

# ── Object Storage (S3-compatible: Sumopod / Cloudeka) ──
S3_ENDPOINT=https://kencana.basic.box.cloudeka.id
S3_REGION=kencana
S3_BUCKET=neuvarixal-storage-vpkfa4
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://kencana.basic.box.cloudeka.id/neuvarixal-storage-vpkfa4

# ── CMS auth (diisi saat fase auth) ──
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# AUTH_SESSION_SECRET=
