# /etc/nginx/sites-available/shobiryne  — contoh reverse proxy.
# TLS: `certbot --nginx -d shobiryne.example`.

server {
    listen 80;
    server_name shobiryne.example www.shobiryne.example;

    # foto CMS (/api/img) sudah immutable 1 tahun dari app — cache di proxy juga
    location /api/img/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 30d;
        add_header X-Proxy-Cache $upstream_cache_status;
        proxy_hide_header Set-Cookie;
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 45m;   # upload foto (batas app 40 MB)
    }
}
